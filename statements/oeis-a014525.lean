import Mathlib

/-!
# A014525: Order of shuffle group for deck of 3n cards.

Source: https://oeis.org/A014525
Credit: @Solfanbtc

Definition (the Magma program of the entry, with cards `0, ..., 3n - 1` instead of
`1, ..., 3n`): `a(n)` is the order of the subgroup of `Sym(3n)` generated by
* `p = ∏_{i<n} (i, i+2n)`: swap the top and bottom thirds, `j ↦ j + 2n` (`j < n`),
  `j ↦ j - 2n` (`j ≥ 2n`), fixing the middle third;
* `q = ∏_{i<n} (i, i+n, i+2n)`: `j ↦ (j + n) mod 3n`;
* `s`: the 3-way perfect shuffle `j ↦ (j mod 3) * n + j / 3` (Magma: `s[i] = ((i-1) mod 3)*n
  + (i-1) div 3 + 1`).
Each generator is given by its values; `gens n` is the set of permutations with those values.
Data check: brute-force closure gives orders `6, 720, 72` for `n = 1, 2, 3`, as in the entry.

Conjecture (Sean A. Irvine, Nov 07 2018): `a(3^m) = (m+1) * 6^(m+1)`, `a(4m) = (3*4*m)! / 2`,
otherwise `a(n) = (3n)!`.
Minimal fix: at `n = 0 = 4 * 0` the formula would give `0! / 2 = 1/2`, while `a(0) = 1`; so
the second clause is stated for `m ≥ 1` and the third for `n ≥ 1` (for `n ≥ 1` the cases
`n = 3^m` and `4 ∣ n` are disjoint). The halving is stated as `2 * a(4m) = (12m)!`.
-/

namespace OMA.S_oeis_a014525

/-- Swap of the top and bottom thirds of a deck of `3n` cards. -/
def pMap (n j : ℕ) : ℕ := if j < n then j + 2 * n else if 2 * n ≤ j then j - 2 * n else j

/-- Cyclic move of the thirds: `j ↦ (j + n) mod 3n`. -/
def qMap (n j : ℕ) : ℕ := (j + n) % (3 * n)

/-- The 3-way perfect shuffle: `j ↦ (j mod 3) * n + j / 3`. -/
def sMap (n j : ℕ) : ℕ := (j % 3) * n + j / 3

/-- The generators of the shuffle group of `3n` cards. -/
def gens (n : ℕ) : Set (Equiv.Perm (Fin (3 * n))) :=
  {σ | (∀ j, (σ j : ℕ) = pMap n j) ∨ (∀ j, (σ j : ℕ) = qMap n j) ∨
    (∀ j, (σ j : ℕ) = sMap n j)}

/-- A014525(n): the order of the shuffle group for a deck of `3n` cards. -/
noncomputable def a (n : ℕ) : ℕ := Nat.card (Subgroup.closure (gens n))

/-- Irvine's conjecture for A014525. -/
theorem main :
    (∀ m : ℕ, a (3 ^ m) = (m + 1) * 6 ^ (m + 1)) ∧
    (∀ m : ℕ, 1 ≤ m → 2 * a (4 * m) = (3 * (4 * m)).factorial) ∧
    (∀ n : ℕ, 1 ≤ n → (¬ ∃ m : ℕ, n = 3 ^ m) → ¬ 4 ∣ n → a n = (3 * n).factorial) := by
  sorry

end OMA.S_oeis_a014525
