import Mathlib

/-!
# A014766: Numbers k such that the 3k shuffle group does not accomplish a perfect shuffle.

Source: https://oeis.org/A014766
Credit: @Solfanbtc

Conjecture (S. A. Irvine, 2018, in the entry): k is in the sequence if k = 3^(m+1) or
k = 12 m for m ≥ 1.

Conventions.
* The shuffle group is the one of the companion entry A014525 (same references, Bosma et
  al. Sect. 2.2.3 and Cannon–Playoust Sect. 6.3.1), given there by a Magma program: for a deck
  of 3n cards (positions 0, ..., 3n-1, cut into three packs of n), it is generated by
  - `p`: exchange the first and third packs, i ↔ i + 2n (i < n);
  - `q`: cycle the packs, i ↦ i + n ↦ i + 2n ↦ i (i < n);
  - `s`: the perfect 3-way shuffle, i ↦ (i mod 3)·n + ⌊i/3⌋ (Magma's permutation from the
    sequence [((i-1) mod 3)·n + (i-1) div 3 + 1], shifted to 0-based positions).
* The terms 9, 12, 24, 27, 36, ... are deck sizes: k is in the sequence iff k = 3n with n ≥ 1
  and the shuffle group of the 3n-card deck is not the whole symmetric group, i.e. some
  permutation of the deck cannot be accomplished. This matches A014525
  (orders 6, 720, 72 = |G| < 9!, 12!/2, 15!, ... for n = 1, 2, 3, 4, 5, ...) and was checked
  numerically against all listed terms (k ≤ 120) with a permutation-group computation.
* "if" is read as a characterization ("iff"): the same author's companion conjecture in
  A014525 explicitly says "otherwise a(n) = (3n)!", i.e. no other deck size is in the
  sequence; the listed data agree with the characterization exactly.
-/

namespace OMA.S_oeis_a014766

open Equiv

/-- `p`: exchange the first and third packs of a 3n-card deck. -/
def packSwap (n : ℕ) : Perm (Fin (3 * n)) :=
  ((List.finRange n).map fun i =>
    swap (⟨i.val, by omega⟩ : Fin (3 * n)) ⟨i.val + 2 * n, by omega⟩).prod

/-- `q`: cycle the three packs, i ↦ i + n ↦ i + 2n ↦ i. -/
def packCycle (n : ℕ) : Perm (Fin (3 * n)) :=
  ((List.finRange n).map fun i =>
    swap (⟨i.val, by omega⟩ : Fin (3 * n)) ⟨i.val + 2 * n, by omega⟩ *
      swap (⟨i.val, by omega⟩ : Fin (3 * n)) ⟨i.val + n, by omega⟩).prod

/-- `s`: the perfect shuffle i ↦ (i mod 3)·n + ⌊i/3⌋. -/
def perfectShuffle (n : ℕ) : Perm (Fin (3 * n)) :=
  (finCongr (Nat.mul_comm 3 n)).trans <|
    (finProdFinEquiv (m := n) (n := 3)).symm.trans <|
      (Equiv.prodComm (Fin n) (Fin 3)).trans finProdFinEquiv

/-- The shuffle group of a deck of 3n cards. -/
def shuffleGroup (n : ℕ) : Subgroup (Perm (Fin (3 * n))) :=
  Subgroup.closure {packSwap n, packCycle n, perfectShuffle n}

/-- k is in A014766: k = 3n, n ≥ 1, and the shuffle group of the deck is not all of Sym(3n). -/
def InSeq (k : ℕ) : Prop :=
  ∃ n : ℕ, 1 ≤ n ∧ k = 3 * n ∧ shuffleGroup n ≠ ⊤

theorem main : ∀ k : ℕ,
    InSeq k ↔ ∃ m : ℕ, 1 ≤ m ∧ (k = 3 ^ (m + 1) ∨ k = 12 * m) := by
  sorry

end OMA.S_oeis_a014766
