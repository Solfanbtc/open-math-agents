import Mathlib

/-!
# A097877: Triangle read by rows: T(n,k) is the number of Dyck n-paths with k large components, 0 <= k <= n/2.

Source: https://oeis.org/A097877
Credit: @Solfanbtc

`T(n,k)` counts Dyck paths of semilength `n` with `k` large components: every nonempty Dyck path
is uniquely a concatenation of prime Dyck paths (one return to ground level each), its
components, and a component is large if its semilength is `≥ 2`. (`T(n,k) = 0` for `k > n/2`.)

Conjecture (F. Chapoton, Apr 18 2023): this is the statistic "indegree" of elements in Pallo's
comb posets (and "outdegree" gives A009766). That is: for every `n` and `k`, the number of
binary trees with `n` (internal) nodes whose indegree in the Hasse diagram of Pallo's comb poset
is `k` equals `T(n,k)`.

Formalization of Pallo's comb poset (J. M. Pallo, Right-arm rotation distance between binary
trees, Inform. Process. Lett. 87 (2003) 173–177): the elements are the binary trees with `n`
nodes; a right-arm rotation is a rotation `((A,B),C) ↦ (A,(B,C))` performed at a node of the
right arm (the path from the root through right children). The order is generated by
right-arm rotations; we orient it so that rotating moves DOWN (`s ≤ t` iff `s` is obtained from
`t` by a sequence of right-arm rotations, so the right comb is the least element), and the
indegree of `t` is its number of lower covers `s ⋖ t` (covers are computed from the generated
order, not assumed). This orientation is the one under which the companion claim also holds:
computed in python3 for `n ≤ 8`, the lower-cover (indegree) counts are distributed as rows
`1..8` of A097877 (e.g. `1, 919, 448, 61, 1` for `n = 8`) and the upper-cover (outdegree) counts
as A009766 (`429, 429, 297, 165, 75, 27, 7, 1`); with the opposite orientation the two would be
swapped. Also checked: every right-arm rotation is a cover for `n ≤ 8`. The Dyck path side is
checked with `#eval` against the rows `n ≤ 6` of the data.
-/

namespace OMA.S_oeis_a097877

/-! ### Dyck paths (`true` = up step `U`, `false` = down step `D`) -/

/-- Height after the steps of `w`. -/
def height (w : List Bool) : ℤ := (w.count true : ℤ) - (w.count false : ℤ)

/-- `w` is a Dyck path: all prefix heights are `≥ 0` and the final height is `0`. -/
def IsDyck (w : List Bool) : Prop :=
  (∀ i ∈ Finset.range (w.length + 1), 0 ≤ height (w.take i)) ∧ height w = 0

instance (w : List Bool) : Decidable (IsDyck w) := by unfold IsDyck; infer_instance

/-- Number of returns to ground level = number of components. -/
def numComponents (w : List Bool) : ℕ :=
  ((Finset.Icc 1 w.length).filter (fun i => height (w.take i) = 0)).card

/-- Number of components of semilength 1 (a `UD` starting at ground level). -/
def numSmallComponents (w : List Bool) : ℕ :=
  ((Finset.range w.length).filter
    (fun j => height (w.take j) = 0 ∧ j + 2 ≤ w.length ∧ height (w.take (j + 2)) = 0)).card

/-- Number of large components (semilength `≥ 2`). -/
def numLargeComponents (w : List Bool) : ℕ := numComponents w - numSmallComponents w

/-- `T(n,k)`: Dyck paths of semilength `n` with `k` large components. -/
def T (n k : ℕ) : ℕ :=
  ((Finset.univ : Finset (Fin (2 * n) → Bool)).filter
    (fun w => IsDyck (List.ofFn w) ∧ numLargeComponents (List.ofFn w) = k)).card

/-! ### Pallo's comb poset -/

/-- One right-arm rotation `t ↦ t'`: the rotation `((A,B),C) ↦ (A,(B,C))` at a node of the
right arm of `t`. -/
inductive RightArmRot : BinaryTree Unit → BinaryTree Unit → Prop
  | root (a b c : BinaryTree Unit) :
      RightArmRot (.node () (.node () a b) c) (.node () a (.node () b c))
  | right (l r r' : BinaryTree Unit) :
      RightArmRot r r' → RightArmRot (.node () l r) (.node () l r')

/-- `s ⋖ t` in the comb poset: `s < t` (`s` is obtained from `t` by at least one right-arm
rotation) and nothing lies strictly between them. -/
def IsLowerCover (s t : BinaryTree Unit) : Prop :=
  Relation.TransGen RightArmRot t s ∧
    ¬ ∃ u, Relation.TransGen RightArmRot t u ∧ Relation.TransGen RightArmRot u s

open Classical in
/-- Indegree of `t` in the Hasse diagram of the comb poset on trees with `t.numNodes` nodes. -/
noncomputable def indegree (t : BinaryTree Unit) : ℕ :=
  ((BinaryTree.treesOfNumNodesEq t.numNodes).filter (fun s => IsLowerCover s t)).card

open Classical in
/-- Chapoton's conjecture: the indegree statistic on Pallo's comb poset is distributed as A097877. -/
theorem main : ∀ n k : ℕ,
    ((BinaryTree.treesOfNumNodesEq n).filter (fun t => indegree t = k)).card = T n k := by
  sorry

end OMA.S_oeis_a097877
