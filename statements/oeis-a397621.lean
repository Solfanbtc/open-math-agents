import Mathlib

/-!
# A397621: linear complexity of the binary expansion of Sierpiński numbers

Source: https://oeis.org/A397621
Credit: @Solfanbtc

A397621: `a(n)` is the linear complexity over GF(2) of the binary expansion of `n` (most
significant bit first), as computed by the Berlekamp-Massey algorithm: the length of the shortest
linear feedback shift register (LFSR) that generates `bin(n)`.

Conjecture (in the entry): `a(A001317(n)) = A080079(n)`.

Definitions.
* A001317 (offset 0), Sierpiński's triangle converted to decimal:
  `A001317(n) = Sum_{k=0..n} (binomial(n,k) mod 2) * 2^k`.
* A080079 (offset 1): `A080079(n) = 2^(floor(log_2 n) + 1) - n`.
* Linear complexity of a finite sequence `s_0, …, s_{N-1}` over GF(2): the least `L` such that
  for some `c_1, …, c_L ∈ GF(2)`, `s_i = Sum_{j=1..L} c_j s_{i-j}` for all `L ≤ i < N`
  (Massey's LFSR of length `L`; `L = N` always works). Checked with python3: this definition
  agrees with the entry's Berlekamp-Massey program for `1 ≤ n < 600`, and reproduces the data.

Range. A080079 has offset 1, so the conjecture is stated for `n ≥ 1`. (At `n = 0`,
`A001317(0) = 1` and `a(1) = 1`.) Checked with python3 for `1 ≤ n < 400`.
-/

namespace OMA.S_oeis_a397621

/-- The binary expansion of `n`, most significant bit first, over GF(2). -/
def bits (n : ℕ) : List (ZMod 2) := (Nat.digits 2 n).reverse.map (fun b => (b : ZMod 2))

/-- `s` is generated by an LFSR of length `L` over GF(2). -/
def HasLFSR (s : List (ZMod 2)) (L : ℕ) : Prop :=
  ∃ c : ℕ → ZMod 2, ∀ i, L ≤ i → i < s.length →
    s.getD i 0 = ∑ j ∈ Finset.Icc 1 L, c j * s.getD (i - j) 0

/-- A397621: the linear complexity over GF(2) of the binary expansion of `n`. -/
noncomputable def a (n : ℕ) : ℕ := sInf {L : ℕ | HasLFSR (bits n) L}

/-- A001317: row `n` of Pascal's triangle mod 2, read as a binary number. -/
def sierpinski (n : ℕ) : ℕ := ∑ k ∈ Finset.range (n + 1), (n.choose k % 2) * 2 ^ k

/-- A080079: `2^(floor(log_2 n) + 1) - n`. -/
def a080079 (n : ℕ) : ℕ := 2 ^ (Nat.log 2 n + 1) - n

/-- Conjecture: `a(A001317(n)) = A080079(n)` for `n ≥ 1`. -/
theorem main : ∀ n : ℕ, 1 ≤ n → a (sierpinski n) = a080079 n := by
  sorry

end OMA.S_oeis_a397621
