import Mathlib

/-!
# A350877: The Sisyphus sequence: start the sequence S with a(1) = 1 and extend S with a(n)/2 when a(n) is even, otherwise with a(n) + the smallest prime not yet added.

Source: https://oeis.org/A350877
Credit: @Solfanbtc

Conjecture (OEIS A350877, comment of Allan C. Wechsler, Jan 22 2022, answering the
question "Will every positive integer appear in S?"): all (positive) integers should
eventually appear.

Conventions:
* The sequence is generated by the state `(value, k)`, where `k` counts the primes added so
  far, so the smallest prime not yet added is the `k`-th prime `Nat.nth Nat.Prime k`
  (0-indexed: `Nat.nth Nat.Prime 0 = 2`). The primes are added in increasing order, as in
  the Maple, PARI and Python programs of the entry.
* `state 0 = (1, 0)` corresponds to a(1) = 1, so a(n) = `(state (n - 1)).1`; the offset
  does not matter for the claim, which is that every positive integer `m` is a term.
* `Nat.nth` is noncomputable; a computable copy of `step` (with the primes below 200 listed
  explicitly) evaluated with `#eval` gives the first 40 values
  1, 3, 6, 3, 8, 4, 2, 1, 8, 4, 2, 1, 12, 6, 3, 16, 8, 4, 2, 1, 18, 9, 28, ..., 86, 43,
  matching the data.

Computations recorded in the entry: after 10^16 terms the missing numbers are
167, 211, 296, 334, 360, ... (Benjamin Chaffin, May 17 2026); the problem is open.
-/

namespace OMA.S_oeis_a350877

/-- One step: halve an even value, otherwise add the smallest prime not yet added. -/
noncomputable def step (s : ℕ × ℕ) : ℕ × ℕ :=
  if Even s.1 then (s.1 / 2, s.2) else (s.1 + Nat.nth Nat.Prime s.2, s.2 + 1)

/-- `state n = (a(n+1), number of primes added so far)`. -/
noncomputable def state (n : ℕ) : ℕ × ℕ := step^[n] (1, 0)

/-- Conjecture: every positive integer appears in the Sisyphus sequence. -/
theorem main : ∀ m : ℕ, 0 < m → ∃ n : ℕ, (state n).1 = m := by
  sorry

end OMA.S_oeis_a350877
