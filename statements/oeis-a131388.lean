import Mathlib

/-!
# A131388: Sequence (a(n)) generated by Rule 1 (in Comments) with a(1) = 1 and d(1) = 0.

Source: https://oeis.org/A131388 (Clark Kimberling, 2007, revised 2015; OEIS Foundation,
CC BY-SA 4.0). Companion sequence of differences: A131389.
Credit: @Solfanbtc

Rule 1. For k ≥ 1 let A(k) = {a(1), ..., a(k)} and D(k) = {d(1), ..., d(k)}.
* Step 1: if there is an integer h with 1 - a(k) < h < 0, h ∉ D(k) and a(k) + h ∉ A(k), let
  d(k+1) be the greatest such h and a(k+1) = a(k) + h; repeat Step 1. Otherwise do Step 2.
* Step 2: let h be the least positive integer with h ∉ D(k) and a(k) + h ∉ A(k); let
  a(k+1) = a(k) + h, d(k+1) = h, and do Step 1.

Conjecture (OEIS): if a(1) is a nonnegative integer and d(1) is an integer, then (a(n)) is a
permutation of the nonnegative integers (if a(1) = 0) or of the positive integers (if a(1) > 0).
Moreover, (d(n)) is a permutation of the integers if d(1) = 0, or of the nonzero integers if
d(1) > 0. (The source makes no claim about (d(n)) when d(1) < 0, so neither do we.)

Formalization notes.
* Time 0 below is the OEIS index 1: `orbit a d 0` holds a(1) = a and d(1) = d.
* Injectivity of both sequences holds by construction (every new h avoids D(k) and every new
  a(k) + h avoids A(k)), so "permutation of S" means: injective with range exactly S.
* Minimal fixes of trivial counterexamples to the literal wording, which are forced by the rule
  itself. A Step 1 move gives a(k+1) = a(k) + h > 1, and a Step 2 move increases a(k), so the
  value 1 can only be reached as a(1) or by a Step 2 move from a(k) = 0, i.e. from a(1) = 0 with
  h = 1 ∉ D(1). Hence 1 never occurs when a(1) ≥ 2, nor when a(1) = 0 and d(1) = 1 (a python
  simulation of 20000 terms confirms that for 0 ≤ a(1) ≤ 3 and -5 ≤ d(1) ≤ 5 these are the only
  missing values in [0, 40) and the only missing differences in [-20, 20], apart from 0 when
  d(1) ≠ 0). `positions` therefore removes 1 from the target set exactly in
  those cases; otherwise it is the set stated in the source.
* Step 2 searches h in 1, ..., cap, where cap = 1 + |a(k)| + Σ|D(k)| + Σ|A(k)| is itself always
  admissible (it exceeds every |d(i)|, and a(k) + cap exceeds every element of A(k)), so the
  search always succeeds and the fallback value is never used. In Step 1 the list
  -1, -2, ..., 2 - a(k) is exactly the set of integers h with 1 - a(k) < h < 0, in decreasing
  order, so the first admissible one is the greatest.
-/

namespace OMA.S_oeis_a131388

/-- The current term a(k), the current difference d(k), and the earlier terms. -/
structure History where
  a : ℤ
  d : ℤ
  earlierA : List ℤ
  earlierD : List ℤ

/-- One move of Rule 1. -/
def step (s : History) : History :=
  let as := s.a :: s.earlierA
  let ds := s.d :: s.earlierD
  -- the integers h with 1 - a < h < 0, greatest first: -1, -2, ..., 2 - a
  let negatives := (List.range (s.a - 2).toNat).map (fun i : ℕ => -1 - (i : ℤ))
  let downward := negatives.find? (fun h => !ds.contains h && !as.contains (s.a + h))
  let cap := 1 + s.a.natAbs + (ds.map Int.natAbs).sum + (as.map Int.natAbs).sum
  let upward := ((List.range cap).map (fun i : ℕ => (i : ℤ) + 1)).find?
    (fun h => !ds.contains h && !as.contains (s.a + h))
  let h := downward.getD (upward.getD (cap : ℤ))
  ⟨s.a + h, h, as, ds⟩

/-- `orbit a d n` is the state at OEIS index n + 1, started from a(1) = a, d(1) = d. -/
def orbit (a : ℕ) (d : ℤ) : ℕ → History
  | 0 => ⟨a, d, [], []⟩
  | n + 1 => step (orbit a d n)

/-- `f` is a bijection from ℕ onto `s`. -/
def permutes (f : ℕ → ℤ) (s : Set ℤ) : Prop :=
  Function.Injective f ∧ Set.range f = s

/-- The conjectured value set of (a(n)), with 1 removed where the rule forbids it. -/
def positions (a : ℕ) (d : ℤ) : Set ℤ :=
  if a = 0 then {z | 0 ≤ z ∧ (d ≠ 1 ∨ z ≠ 1)}
  else if a = 1 then {z | 0 < z} else {z | 1 < z}

theorem main : ∀ (a : ℕ) (d : ℤ),
    permutes (fun n => (orbit a d n).a) (positions a d) ∧
    (d = 0 → permutes (fun n => (orbit a d n).d) Set.univ) ∧
    (0 < d → permutes (fun n => (orbit a d n).d) {z | z ≠ 0}) := by
  sorry

end OMA.S_oeis_a131388
