import Mathlib

/-!
# A119485: Number of children for which any subset can be generated by a counting-out game.

Source: https://oeis.org/A119485
Credit: @Solfanbtc

Conjecture (J. Fricke and G. Woeginger, OEIS A119485, %F line): the sequence contains exactly
the powers of 2, the primes and the doubled primes (A058363), together with 1.

The game. `n` children stand in a circle. For a fixed count `k ≥ 1`, one counts `k` children
starting at child 1; the child reached leaves the circle, and counting resumes (again up to
`k`) at the next remaining child, and so on. A subset `S` of the children can be generated if
for some `k` the first `|S|` children to leave are exactly those of `S`. `n` is a term if every
subset of the `n` children can be generated. Example from the entry: with 6 children and
`k = 42` the first children to leave are 6, 2, 4, which generates `{2, 4, 6}`.

Formalization.
* Children are `0, ..., n-1` (child `i + 1` of the source is `i`). `elimAux fuel circ pos k`
  removes the child at index `(pos + k - 1) mod |circ|` of the current circle `circ` and goes
  on from the index of the next child; `elimOrder n k` is the full elimination order.
* `IsTerm n`: every `S ⊆ {0, ..., n-1}` is the set of the first `|S|` eliminated children for
  some `k ≥ 1` (`S = ∅` is trivial).
* The conjecture: for `n ≥ 1`, `IsTerm n` iff `n` is a power of 2 (including `1 = 2^0`), a prime,
  or twice a prime.

Checked with python3 (exhaustive over `1 ≤ k ≤ lcm(1, ..., n)`, which covers all counts since
the game only depends on `k` modulo `1, ..., n`): the terms up to 14 are
`1, 2, 3, 4, 5, 6, 7, 8, 10, 11, 13, 14`, as listed; `#eval` of `elimOrder 6 42` begins
`5, 1, 3` (children 6, 2, 4), as in the example.
-/

namespace OMA.S_oeis_a119485

/-- Josephus-style elimination: `fuel` bounds the number of removals. -/
def elimAux : ℕ → List ℕ → ℕ → ℕ → List ℕ
  | 0, _, _, _ => []
  | fuel + 1, circ, pos, k =>
    if circ = [] then []
    else
      let p := (pos + k - 1) % circ.length
      circ.getD p 0 :: elimAux fuel (circ.eraseIdx p) (p % (circ.length - 1)) k

/-- The order in which the children `0, ..., n-1` leave the circle when counting to `k`. -/
def elimOrder (n k : ℕ) : List ℕ := elimAux n (List.range n) 0 k

/-- Every subset of the `n` children can be generated by the counting-out game. -/
def IsTerm (n : ℕ) : Prop :=
  ∀ S : Finset ℕ, S ⊆ Finset.range n → ∃ k : ℕ, 1 ≤ k ∧ ((elimOrder n k).take S.card).toFinset = S

/-- Fricke–Woeginger: the terms are exactly the powers of 2, the primes and twice the primes. -/
theorem main : ∀ n : ℕ, 1 ≤ n →
    (IsTerm n ↔ (∃ j : ℕ, n = 2 ^ j) ∨ n.Prime ∨ ∃ p : ℕ, p.Prime ∧ n = 2 * p) := by
  sorry

end OMA.S_oeis_a119485
