import Mathlib

/-!
# A178772: Fibonacci integers.

Source: https://oeis.org/A178772
Credit: @Solfanbtc

Conjecture (Luca, Pomerance & Wagner, Fibonacci integers, J. Number Theory 131 (2011),
quoted in the entry by Charles R Greathouse IV, Aug 31 2016): with F(x) the number of terms
`≤ x`, the proved estimate
  exp(c √(log x) - (log x)^e) < F(x) < exp(c √(log x) + (log x)^(1/6 + e))  (every e > 0)
remains true with 1/6 replaced by 0.

Conventions.
* A Fibonacci integer is a positive integer that is a product and/or quotient of Fibonacci
  numbers, i.e. an integer in the subgroup of ℚˣ generated by the nonzero Fibonacci numbers
  F(1), F(2), ... (the definition of the paper; the entry's example: 33 = F(10) F(4) / F(5)).
* The entry does not give a value for c ("where c is this constant"; it is the explicit constant
  of the paper). The statement therefore says that some real c makes both bounds hold with
  exponent `0 + e`. This is the same claim: any c for which these bounds hold for every e > 0
  satisfies log F(x) / √(log x) → c, so c is uniquely determined by F, and by the proved estimate
  it is the paper's constant.
* Such asymptotic bounds are meant for all sufficiently large x (depending on e): at x = 1 both
  sides equal 1 = F(1), so the strict inequalities cannot hold for every x. Hence
  `∀ᶠ x in atTop`.
-/

namespace OMA.S_oeis_a178772

open Filter Real

/-- The subgroup of ℚˣ generated by the Fibonacci numbers F(1), F(2), .... -/
def fibGroup : Subgroup ℚˣ :=
  Subgroup.closure (Set.range fun k : ℕ =>
    Units.mk0 ((Nat.fib (k + 1) : ℕ) : ℚ) (by
      have := Nat.fib_pos.mpr (Nat.succ_pos k)
      exact_mod_cast this.ne'))

/-- `n` is a Fibonacci integer (a term of A178772). -/
def IsFibonacciInteger (n : ℕ) : Prop :=
  1 ≤ n ∧ ∃ u ∈ fibGroup, (u : ℚ) = n

/-- F(x): the number of Fibonacci integers `≤ x`. -/
noncomputable def countUpTo (x : ℝ) : ℕ :=
  {n : ℕ | IsFibonacciInteger n ∧ (n : ℝ) ≤ x}.ncard

theorem main : ∃ c : ℝ, ∀ ε : ℝ, 0 < ε → ∀ᶠ x in atTop,
    exp (c * √(log x) - (log x) ^ ε) < (countUpTo x : ℝ) ∧
      (countUpTo x : ℝ) < exp (c * √(log x) + (log x) ^ ε) := by
  sorry

end OMA.S_oeis_a178772
