import Mathlib

/-!
# A046160: Bends of spheres in Soddy's bowl of integers which are tangent to the unit sphere and a single 2-sphere.

Source: https://oeis.org/A046160
Credit: @Solfanbtc

Conjecture (Martin Fuller, Mar 28 2026, in the entry): the list of bends of all spheres of the
bowl not in the plane is A049636, "Congruent to 0 or 2 mod 3, but not equal to 0 or 3."

Conventions.
* Soddy's bowl of integers (A045506): inside the unit sphere (bend -1, centred at the origin)
  inscribe two spheres of bend 2 centred at (0, 0, ±1/2), then keep inscribing spheres where
  possible. "The plane" is z = 0, the plane through the point of contact of the two 2-spheres
  that contains the ring of six spheres of bend 3 (A046159, and the example in the entry).
* A sphere of bend `k` and centre `(x, y, z)` is recorded by its curvature-centre coordinates
  `(k, k x, k y, k z)`. The bowl is the Apollonian sphere packing generated by the Descartes
  configuration of five mutually tangent spheres: the unit sphere `(-1, 0, 0, 0)`, the two
  2-spheres `(2, 0, 0, ±1)`, and two adjacent spheres of the ring of bend 3, centred at
  `(2/3, 0, 0)` and `(1/3, √3/3, 0)`, i.e. `(3, 2, 0, 0)` and `(3, 1, √3, 0)`. Replacing
  sphere `i` of a Descartes configuration by the other sphere tangent to the remaining four is
  the linear map `v_i ↦ (∑_{j ≠ i} v_j) - v_i` on these coordinates (generalized Descartes
  theorem in dimension 3, Lagarias–Mallows–Wilks, "Beyond the Descartes circle theorem",
  Amer. Math. Monthly 109 (2002)); the spheres of the bowl are the spheres occurring in the
  configurations reachable this way (the orbit of the Apollonian group).
* No sphere of the bowl has bend 0, so a sphere is not in the plane iff `k z ≠ 0`.
* Checked numerically (exact enumeration of the orbit, all bends ≤ 400): the bends of
  spheres with `k z ≠ 0` are exactly the n ≤ 400 with n ≡ 0, 2 (mod 3), n ≠ 0, 3; every
  computed configuration was verified to be five mutually tangent spheres.
* The statement is the full conjecture: a real number is the bend of some sphere of the bowl
  that is not in the plane iff it is a natural number `n` with `n % 3 ∈ {0, 2}`, `n ≠ 0, 3`.
-/

namespace OMA.S_oeis_a046160

/-- Curvature-centre coordinates `(k, k x, k y, k z)` of a sphere. -/
abbrev SphereCoords := Fin 4 → ℝ

/-- A configuration of five spheres. -/
abbrev Config := Fin 5 → SphereCoords

/-- The initial Descartes configuration: the unit sphere, the two 2-spheres and two adjacent
spheres of bend 3 in the plane z = 0. -/
noncomputable def initConfig : Config :=
  ![![-1, 0, 0, 0], ![2, 0, 0, 1], ![2, 0, 0, -1], ![3, 2, 0, 0], ![3, 1, Real.sqrt 3, 0]]

/-- Replace sphere `i` by the other sphere tangent to the remaining four:
`v_i ↦ (∑_{j ≠ i} v_j) - v_i = (∑_j v_j) - 2 v_i`. -/
def reflect (i : Fin 5) (c : Config) : Config :=
  Function.update c i ((∑ j, c j) - 2 • c i)

/-- Configurations of the bowl: those reachable from `initConfig` by reflections. -/
inductive Reachable : Config → Prop
  | init : Reachable initConfig
  | step {c : Config} (i : Fin 5) : Reachable c → Reachable (reflect i c)

/-- A sphere of Soddy's bowl. -/
def InBowl (s : SphereCoords) : Prop :=
  ∃ c : Config, Reachable c ∧ ∃ i : Fin 5, c i = s

theorem main : ∀ x : ℝ,
    (∃ s : SphereCoords, InBowl s ∧ s 3 ≠ 0 ∧ s 0 = x) ↔
      ∃ n : ℕ, (n % 3 = 0 ∨ n % 3 = 2) ∧ n ≠ 0 ∧ n ≠ 3 ∧ x = n := by
  sorry

end OMA.S_oeis_a046160
